{
  "name": "harvest-bot-ui",
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.harvestbot.app",
    "productName": "HarvestBot",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "bot-engine.exe",
        "to": "bot-engine.exe"
      }
    ],
    "win": {
      "target": "portable"
    }
  }
}
